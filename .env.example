APP_NAME="ALG Marketing Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mercadeo.alg3pl.com

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=alg_marketing
DB_USERNAME=
DB_PASSWORD=

# Google APIs
GOOGLE_APPLICATION_CREDENTIALS=storage/app/google-credentials.json
# GA4 and Search Console properties are stored per country in the countries table.
# Keep this account id only as a reference for operational audits.
GOOGLE_ANALYTICS_ACCOUNT=319098934

# Email (SMTP via cPanel)
MAIL_MAILER=smtp
MAIL_HOST=mail.alg3pl.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=marketing@alg3pl.com
MAIL_FROM_NAME="ALG Marketing"

# WhatsApp Business API
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WEBHOOK_URL=https://mercadeo.alg3pl.com/api/v1/webhook/whatsapp
TWILIO_STATUS_CALLBACK_URL=
TWILIO_VALIDATE_WEBHOOK=false
TWILIO_CONTENT_TEMPLATE_MAP={}
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_360DIALOG_API_KEY=
WHATSAPP_360DIALOG_API_BASE=https://waba-v2.360dialog.io

# ONUX
ONUX_NAME="5PL"
ONUX_WHATSAPP_ALERT_NUMBERS=
ONUX_WHATSAPP_ALERT_GROUP_IDS=
ONUX_WHATSAPP_ALLOWED_NUMBERS=
ONUX_WHATSAPP_ALLOWED_GROUP_IDS=
ONUX_WHATSAPP_ALLOW_SANDBOX_PARTICIPANTS=false

# Meta (Facebook/Instagram)
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# 5PL AI provider: openai, qwen, or anthropic.
AI_PROVIDER=openai

# OpenAI chat for 5PL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com

# Claude / Anthropic chat for 5PL and lead enrichment.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional Qwen fallback via Alibaba Cloud Model Studio / DashScope OpenAI-compatible chat API.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Slack — hot lead alerts (score crosses 80)
SLACK_WEBHOOK_URL=

# Google Ads — campaign insights for Tráfico/Ad Metrics widget
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Queue
QUEUE_CONNECTION=database

# Cache
CACHE_DRIVER=file
SESSION_DRIVER=file

# Login helper (dev convenience — shows clickable credentials under /admin login)
# SET TO false IN PRODUCTION. Never commit real credentials.
SHOW_LOGIN_HELPER=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
